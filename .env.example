# InGit Environment Configuration
# Copy this file to .env and update values

# General
ENVIRONMENT=development  # development, production, testing
BUILD_TARGET=development  # development, production

# Database
POSTGRES_PASSWORD=changeme-in-production
DATABASE_URL=postgresql://ingit:changeme@localhost:5432/ingit

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
SECRET_KEY=your-secret-key-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8000/api

# Redis
REDIS_URL=redis://localhost:6379/0

# Git
DEFAULT_BRANCH=main

# Encryption
ENCRYPTION_KEY=your-encryption-key-change-this

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ingit.log

# Storage
STORAGE_PATH=./storage
REPOS_PATH=./storage/repos
UPLOADS_PATH=./storage/uploads

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@ingit.local

# Monitoring (optional)
SENTRY_DSN=
