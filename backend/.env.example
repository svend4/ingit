# InGit Backend Configuration

# Environment
ENVIRONMENT=development  # development, production, testing

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Database
DATABASE_URL=sqlite:///./ingit.db
# For PostgreSQL: postgresql://user:password@localhost/ingit

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Git
DEFAULT_BRANCH=main

# Encryption
ENCRYPTION_KEY=your-encryption-key-change-this

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ingit.log

# Storage
STORAGE_PATH=./storage
REPOS_PATH=./storage/repos
UPLOADS_PATH=./storage/uploads

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
