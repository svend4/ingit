#!/usr/bin/env python3
"""
InGit Post-commit Hook
Automatically update task status and link commits
"""

import sys
import os
import re
import sqlite3
from pathlib import Path
from datetime import datetime

def get_commit_message() -> str:
    """Get the latest commit message"""
    import subprocess
    result = subprocess.run(
        ['git', 'log', '-1', '--pretty=%B'],
        capture_output=True,
        text=True
    )
    return result.stdout.strip()

def get_commit_hash() -> str:
    """Get the latest commit hash"""
    import subprocess
    result = subprocess.run(
        ['git', 'rev-parse', 'HEAD'],
        capture_output=True,
        text=True
    )
    return result.stdout.strip()

def find_task_references(commit_message: str) -> list:
    """Find task references in commit message"""
    # Patterns: "fixes #123", "closes task-042", "resolves #task-001"
    patterns = [
        r'(?:fixes|closes|resolves)\s+#?(\d+)',
        r'(?:fixes|closes|resolves)\s+task-(\d+)',
    ]

    task_ids = []
    for pattern in patterns:
        matches = re.findall(pattern, commit_message, re.IGNORECASE)
        task_ids.extend(matches)

    return task_ids

def update_task_status(task_id: str, commit_hash: str) -> bool:
    """Update task status to 'done' in database"""
    # This is a placeholder - actual implementation would use SQLAlchemy
    print(f"✅ Auto-closing task #{task_id} (commit: {commit_hash[:7]})")
    return True

def link_commit_to_task(commit_hash: str, task_ids: list) -> None:
    """Link commit to tasks in database"""
    if task_ids:
        print(f"🔗 Linking commit {commit_hash[:7]} to tasks: {', '.join(task_ids)}")

def main() -> int:
    """Main hook execution"""
    commit_message = get_commit_message()
    commit_hash = get_commit_hash()

    # Find task references
    task_ids = find_task_references(commit_message)

    if task_ids:
        print(f"\n🎯 Found {len(task_ids)} task reference(s) in commit message")

        for task_id in task_ids:
            update_task_status(task_id, commit_hash)

        link_commit_to_task(commit_hash, task_ids)
        print()

    return 0

if __name__ == "__main__":
    sys.exit(main())
