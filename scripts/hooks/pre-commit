#!/usr/bin/env python3
"""
InGit Pre-commit Hook
Validates YAML metadata and enforces repository rules
"""

import sys
import os
import yaml
from pathlib import Path
from typing import List, Dict, Any, Tuple

# ANSI colors for terminal output
RED = '\033[0;31m'
GREEN = '\033[0;32m'
YELLOW = '\033[1;33m'
NC = '\033[0m'  # No Color

def print_error(msg: str) -> None:
    """Print error message in red"""
    print(f"{RED}❌ {msg}{NC}", file=sys.stderr)

def print_warning(msg: str) -> None:
    """Print warning message in yellow"""
    print(f"{YELLOW}⚠️  {msg}{NC}")

def print_success(msg: str) -> None:
    """Print success message in green"""
    print(f"{GREEN}✅ {msg}{NC}")

def get_staged_files() -> List[str]:
    """Get list of staged files"""
    import subprocess
    result = subprocess.run(
        ['git', 'diff', '--cached', '--name-only', '--diff-filter=ACM'],
        capture_output=True,
        text=True
    )
    return result.stdout.strip().split('\n') if result.stdout else []

def check_inbox_files(staged_files: List[str]) -> bool:
    """Block commits from 00_inbox folder"""
    inbox_files = [f for f in staged_files if f.startswith('00_inbox/')]
    if inbox_files:
        print_error("Cannot commit files from 00_inbox/")
        print_error("Please move files to appropriate folders before committing:")
        for f in inbox_files:
            print(f"  - {f}")
        return False
    return True

def check_file_size(staged_files: List[str], max_mb: int = 25) -> bool:
    """Check if files exceed size limit"""
    max_bytes = max_mb * 1024 * 1024
    large_files = []

    for file_path in staged_files:
        if os.path.exists(file_path):
            size = os.path.getsize(file_path)
            if size > max_bytes:
                size_mb = size / (1024 * 1024)
                large_files.append((file_path, size_mb))

    if large_files:
        print_error(f"Files exceed {max_mb}MB limit (consider Git LFS):")
        for file_path, size_mb in large_files:
            print(f"  - {file_path}: {size_mb:.2f}MB")
        return False
    return True

def validate_yaml_file(file_path: str) -> Tuple[bool, str]:
    """Validate YAML file and check required fields"""
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            data = yaml.safe_load(f)

        if not isinstance(data, dict):
            return False, "YAML must contain a dictionary"

        # Check for required fields based on type
        doc_type = data.get('type')

        required_fields = {
            'task': ['type', 'title', 'status', 'priority'],
            'contract': ['type', 'title', 'date', 'parties', 'amount'],
            'document': ['type', 'title', 'date'],
            'expense': ['type', 'title', 'date', 'amount', 'category'],
            'income': ['type', 'title', 'date', 'amount', 'category'],
        }

        if doc_type in required_fields:
            missing_fields = [
                field for field in required_fields[doc_type]
                if field not in data
            ]
            if missing_fields:
                return False, f"Missing required fields: {', '.join(missing_fields)}"

        # Validate task status transitions
        if doc_type == 'task':
            valid_statuses = ['backlog', 'todo', 'in_progress', 'review', 'blocked', 'done', 'cancelled']
            status = data.get('status')
            if status not in valid_statuses:
                return False, f"Invalid status '{status}'. Must be one of: {', '.join(valid_statuses)}"

        return True, "OK"

    except yaml.YAMLError as e:
        return False, f"YAML syntax error: {str(e)}"
    except Exception as e:
        return False, f"Error: {str(e)}"

def check_yaml_files(staged_files: List[str]) -> bool:
    """Validate all YAML files"""
    yaml_files = [f for f in staged_files if f.endswith(('.yaml', '.yml'))]

    if not yaml_files:
        return True

    print(f"\n🔍 Validating {len(yaml_files)} YAML file(s)...")

    errors = []
    for file_path in yaml_files:
        if os.path.exists(file_path):
            is_valid, message = validate_yaml_file(file_path)
            if not is_valid:
                errors.append((file_path, message))
            else:
                print_success(f"{file_path}: {message}")

    if errors:
        print_error("YAML validation failed:")
        for file_path, message in errors:
            print(f"  - {file_path}: {message}")
        return False

    return True

def check_commit_message() -> bool:
    """Validate commit message format (optional)"""
    # This would be implemented in commit-msg hook
    return True

def main() -> int:
    """Main hook execution"""
    print("\n🚀 Running InGit pre-commit checks...\n")

    staged_files = get_staged_files()

    if not staged_files or staged_files == ['']:
        print_warning("No files staged for commit")
        return 0

    print(f"📁 Checking {len(staged_files)} staged file(s)...\n")

    # Run all checks
    checks = [
        ("Inbox files", check_inbox_files(staged_files)),
        ("File sizes", check_file_size(staged_files)),
        ("YAML validation", check_yaml_files(staged_files)),
    ]

    # Print results
    print("\n" + "="*50)
    print("Check Results:")
    print("="*50)

    all_passed = True
    for check_name, passed in checks:
        if passed:
            print_success(f"{check_name}")
        else:
            print_error(f"{check_name}")
            all_passed = False

    print("="*50 + "\n")

    if all_passed:
        print_success("All checks passed! ✨\n")
        return 0
    else:
        print_error("Some checks failed. Please fix the issues above.\n")
        return 1

if __name__ == "__main__":
    sys.exit(main())
